# =====================================================================
# Youtube2Anki - configuração
# Copie este arquivo para ".env" e preencha os valores antes de rodar.
# O ".env" NÃO deve ir para o git (já está no .gitignore).
# =====================================================================

# --- IA (qualquer API compatível com o padrão OpenAI /chat/completions) ---

# Chave da API. Para OpenRouter: https://openrouter.ai/settings/keys
# (passo a passo na seção "Como obter uma chave de API do OpenRouter" do README)
AI_API_KEY=coloque-sua-chave-aqui

# URL base da API (sem o "/chat/completions" no final).
# ATENÇÃO: a URL precisa ser do MESMO provedor da chave.
#   Chave "sk-or-..."   -> OpenRouter
#   Chave "sk-proj-..." -> OpenAI
# Exemplos:
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://openrouter.ai/api/v1

# Modelo a ser usado. Exemplos (OpenRouter):
#   openai/gpt-4o-mini
#   openai/gpt-oss-20b:free
# Exemplo (OpenAI direto): gpt-4o-mini
AI_MODEL=openai/gpt-4o-mini

# Temperatura da geração (0 a 1). Valores baixos = respostas mais consistentes.
AI_TEMPERATURE=0.3

# Limite de tokens da resposta. Deixe vazio para usar o padrão do provedor.
AI_MAX_TOKENS=

# --- Servidor local ---

# Porta do servidor Python (http://localhost:PORTA)
APP_PORT=8765

# Abrir o navegador automaticamente ao iniciar (true/false)
APP_OPEN_BROWSER=true
